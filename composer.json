{
  "name": "citylens/citylens", "description": "A web and CLI weather application", "type": "project", "license": "MIT",
  "require": {"php": "^8.2", "ext-curl": "*", "ext-json": "*"},
  "require-dev": {"phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"CityLens\\": "src/"}}, "autoload-dev": {"psr-4": {"CityLens\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "lint": "find . -path ./vendor -prune -o -path ./skycons -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"},
  "config": {"sort-packages": true}
}
